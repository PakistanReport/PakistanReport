{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pakistan-report-publisher",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "PUBLISHER", "class_name": "Publisher" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Publisher"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
}
